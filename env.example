# ──────────────────────────────────────────────────────────────────────
# Environment variables used by docker-compose.yml
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=analytics

# ── Producer API ─────────────────────────────────────────────────────
PRODUCER_PORT=8081
